+#[derive(Debug)]
+pub(crate) struct EffortStatusCell {
+    snapshot: EffortStatusSnapshot,
+}
+
+impl EffortStatusCell {
+    pub(crate) fn new(snapshot: EffortStatusSnapshot) -> Self {
+        Self { snapshot }
+    }
+
+    fn lines(&self, width: u16) -> Vec<Line<'static>> {
+        let mut lines: Vec<Line<'static>> = Vec::new();
+        lines.push(Line::from(
+            Span::from(self.snapshot.scope.title().to_string()).bold(),
+        ));
+        lines.push(Line::from(""));
+
+        if width < NARROW_LAYOUT_WIDTH {
+            lines.extend(self.narrow_rows());
+        } else {
+            lines.extend(self.table_rows());
+        }
+
+        // `rows` is only empty for `/effort agents` with nothing running; every other scope always
+        // carries the parent row, so one message covers both cases.
+        if self.snapshot.scope.includes_agents()
+            && !self.snapshot.rows.iter().any(|row| !row.is_parent)
+        {
+            if !self.snapshot.rows.is_empty() {
+                lines.push(Line::from(""));
+            }
+            lines.push(Line::from(Span::from("No active subagents.").dim()));
+        }
+
+        lines.push(Line::from(""));
+        lines.push(self.footer_line());
+        if let Some(note) = &self.snapshot.note {
+            lines.push(Line::from(Span::from(note.clone()).yellow()));
+        }
+        lines
+    }
+
+    fn table_rows(&self) -> Vec<Line<'static>> {
+        let headers = ["Role", "Model", "Effort", "State"];
+        let mut widths = headers.map(display_width);
+        for row in &self.snapshot.rows {
+            widths[0] = widths[0].max(display_width(&row.label));
+            widths[1] = widths[1].max(display_width(&row.model));
+            widths[2] = widths[2].max(display_width(&row.effort));
+            widths[3] = widths[3].max(display_width(row.state));
+        }
+
+        let mut lines = Vec::with_capacity(self.snapshot.rows.len() + 2);
+        lines.push(Line::from(
+            Span::from(pad_columns(
+                &headers.map(ToOwned::to_owned),
+                &widths,
+                /*pad_last*/ false,
+            ))
+            .dim(),
+        ));
+        let rule_width: usize =
+            widths.iter().sum::<usize>() + COLUMN_GAP * (widths.len().saturating_sub(1));
+        lines.push(Line::from(Span::from("─".repeat(rule_width)).dim()));
+
+        for row in &self.snapshot.rows {
+            let cells = [
+                row.label.clone(),
+                row.model.clone(),
+                row.effort.clone(),
+                row.state.to_string(),
+            ];
+            let mut spans = vec![Span::from(pad_columns(
+                &cells,
+                &widths,
+                /*pad_last*/ row.inherited,
+            ))];
+            if row.inherited {
+                spans.push(Span::from("  inherited").dim());
+            }
+            let line = Line::from(spans);
+            lines.push(if row.is_parent { line.bold() } else { line });
+        }
+        lines
+    }
+
+    fn narrow_rows(&self) -> Vec<Line<'static>> {
+        let mut lines = Vec::with_capacity(self.snapshot.rows.len() * 2);
+        for row in &self.snapshot.rows {
+            let label = Line::from(Span::from(row.label.clone()));
+            lines.push(if row.is_parent { label.bold() } else { label });
+            let mut detail = format!("  {} · {} · {}", row.model, row.effort, row.state);
+            if row.inherited {
+                detail.push_str(" · inherited");
+            }
+            lines.push(Line::from(Span::from(detail).dim()));
+        }
+        lines
+    }
+
+    fn footer_line(&self) -> Line<'static> {
+        let routing = if self.snapshot.auto_routing_enabled {
+            "enabled"
+        } else {
+            "disabled"
+        };
+        let workers = match self.snapshot.max_agents {
+            Some(max_agents) => format!("{}/{max_agents}", self.snapshot.active_agents),
+            None => self.snapshot.active_agents.to_string(),
+        };
+        Line::from(Span::from(format!("Routing: {routing} · Workers: {workers}")).dim())
+    }
+}
+
+impl HistoryCell for EffortStatusCell {
+    fn display_lines(&self, width: u16) -> Vec<Line<'static>> {
+        self.lines(width)
+    }
+
+    fn raw_lines(&self) -> Vec<Line<'static>> {
+        plain_lines(self.lines(u16::MAX))
+    }
+}
+
+fn pad_columns(cells: &[String; 4], widths: &[usize; 4], pad_last: bool) -> String {
+    let mut out = String::new();
+    for (index, cell) in cells.iter().enumerate() {
+        out.push_str(cell);
+        let is_last = index + 1 == cells.len();
+        if is_last && !pad_last {
+            break;
+        }
+        let padding = widths[index].saturating_sub(display_width(cell));
+        out.push_str(&" ".repeat(padding));
+        if !is_last {
+            out.push_str(&" ".repeat(COLUMN_GAP));
+        }
+    }
+    out
+}
+
+/// Builds the transcript cell for one `/effort` invocation, echoing the command first so the
+/// output reads like the other local commands.
+pub(crate) fn new_effort_status_output(
+    command: String,
+    snapshot: EffortStatusSnapshot,
+) -> CompositeHistoryCell {
+    let echo = PlainHistoryCell::new(vec![Line::from(Span::from(command).magenta())]);
+    CompositeHistoryCell::new(vec![
+        Box::new(echo),
+        Box::new(EffortStatusCell::new(snapshot)),
+    ])
+}
