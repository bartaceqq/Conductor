+//! `/effort` handling for `ChatWidget`.
+//!
+//! The command is a local inspection action: it never queues a turn and never reaches the model.
+//! Status variants ask `App` to read live thread state from the app server; level variants reuse
+//! the same reasoning-effort update path as `/model` and the `Alt+,` / `Alt+.` shortcuts, so they
+//! only affect subsequent turns.
+
+use codex_protocol::config_types::ModeKind;
+
+use super::ChatWidget;
+use crate::app_event::AppEvent;
+use crate::effort_status::EffortStatusScope;
+use crate::effort_status::EffortStatusSnapshot;
+use crate::effort_status::parse_effort_level;
+
+pub(super) const EFFORT_USAGE: &str =
+    "Usage: /effort [all|parent|agents] or /effort <low|medium|high|xhigh|max>";
+
+impl ChatWidget {
+    /// Entry point for both `/effort` and `/effort <arg>`.
+    pub(crate) fn handle_effort_command(&mut self, args: &str) {
+        let trimmed = args.trim();
+        match EffortStatusScope::parse(trimmed) {
+            Ok(scope) => self.request_effort_status(scope, trimmed),
+            Err(unknown) => {
+                // A bare level such as `/effort high` adjusts the parent instead of reporting.
+                if let Some(effort) = parse_effort_level(&unknown) {
+                    self.apply_effort_level(effort);
+                } else {
+                    self.add_error_message(EFFORT_USAGE.to_string());
+                }
+            }
+        }
+    }
+
+    fn request_effort_status(&mut self, scope: EffortStatusScope, args: &str) {
+        let command = if args.is_empty() {
+            "/effort".to_string()
+        } else {
+            format!("/effort {args}")
+        };
+        self.app_event_tx
+            .send(AppEvent::RequestEffortStatus { command, scope });
+    }
+
+    fn apply_effort_level(&mut self, effort: codex_protocol::openai_models::ReasoningEffort) {
+        if self.collaboration_modes_enabled() && self.active_mode_kind() == ModeKind::Plan {
+            let warning = self.ultra_reasoning_concurrency_warning(&effort);
+            self.app_event_tx
+                .send(AppEvent::UpdatePlanModeReasoningEffort(Some(effort)));
+            if let Some(warning) = warning {
+                self.app_event_tx.send(AppEvent::InsertHistoryCell(Box::new(
+                    crate::history_cell::new_warning_event(warning),
+                )));
+            }
+        } else {
+            self.app_event_tx
+                .send(AppEvent::UpdateReasoningEffort(Some(effort)));
+        }
+    }
+
+    /// Appends the rendered `/effort` output once the background read finishes.
+    pub(crate) fn add_effort_status_output(
+        &mut self,
+        command: String,
+        snapshot: EffortStatusSnapshot,
+    ) {
+        self.add_to_history(crate::effort_status::new_effort_status_output(
+            command, snapshot,
+        ));
+    }
+
+    /// Model and reasoning effort the TUI currently believes the parent thread uses.
+    ///
+    /// Only used as a fallback when the live app-server read for the root thread fails.
+    pub(crate) fn effort_status_parent_fallback(&self) -> crate::effort_status::ParentFallback {
+        crate::effort_status::ParentFallback {
+            model: Some(self.current_model().to_string()).filter(|model| !model.is_empty()),
+            reasoning_effort: self.effective_reasoning_effort(),
+        }
+    }
+}
