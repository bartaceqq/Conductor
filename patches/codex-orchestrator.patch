index 0000000000..040c4ced99
--- /dev/null
+++ b/codex-rs/tui/src/app/effort_status.rs
@@ -0,0 +1,163 @@
+//! Background runtime read behind the `/effort` command.
+//!
+//! `/effort` must report what each agent in this session is *actually* running with, so the rows
+//! come from the app server's live thread records rather than from `config.toml` or an agent-role
+//! file. For a loaded thread the app server fills `model` and `reasoningEffort` from that thread's
+//! `ThreadConfigSnapshot`, which is the configuration Codex resolved after spawn overrides,
+//! `[agents]` defaults, parent inheritance, and role config files were applied.
+//!
+//! Both requests used here are read-only and are not serialized behind a running turn, so the
+//! command works while agents are busy and never interrupts them. No model request is issued.
+
+use super::*;
+use crate::app_event::EffortStatusReadout;
+use crate::effort_status::EffortStatusInputs;
+use crate::effort_status::EffortStatusScope;
+use crate::effort_status::build_effort_status;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::SortDirection;
+use codex_app_server_protocol::Thread;
+use codex_app_server_protocol::ThreadListParams;
+use codex_app_server_protocol::ThreadListResponse;
+use codex_app_server_protocol::ThreadReadParams;
+use codex_app_server_protocol::ThreadReadResponse;
+use codex_app_server_protocol::ThreadSourceKind;
+
+/// Upper bound on subagent rows collected for one `/effort` invocation.
+const EFFORT_STATUS_MAX_AGENTS: u32 = 100;
+
+impl App {
+    pub(super) fn request_effort_status(
+        &mut self,
+        app_server: &AppServerSession,
+        command: String,
+        scope: EffortStatusScope,
+    ) {
+        let Some(root) = self
+            .primary_thread_id
+            .or_else(|| self.chat_widget.thread_id())
+        else {
+            self.chat_widget.add_error_message(
+                "Session is still starting; try /effort again in a moment.".to_string(),
+            );
+            return;
+        };
+
+        let request_handle = app_server.request_handle();
+        let app_event_tx = self.app_event_tx.clone();
+        let needs_agents = scope != EffortStatusScope::Parent;
+        tokio::spawn(async move {
+            let parent = request_handle
+                .request_typed::<ThreadReadResponse>(ClientRequest::ThreadRead {
+                    request_id: RequestId::String(Uuid::new_v4().to_string()),
+                    params: ThreadReadParams {
+                        thread_id: root.to_string(),
+                        include_turns: false,
+                    },
+                })
+                .await;
+            let agents = if needs_agents {
+                request_handle
+                    .request_typed::<ThreadListResponse>(ClientRequest::ThreadList {
+                        request_id: RequestId::String(Uuid::new_v4().to_string()),
+                        params: ThreadListParams {
+                            originators: None,
+                            cursor: None,
+                            limit: Some(EFFORT_STATUS_MAX_AGENTS),
+                            sort_key: None,
+                            sort_direction: Some(SortDirection::Desc),
+                            model_providers: Some(Vec::new()),
+                            source_kinds: Some(vec![ThreadSourceKind::SubAgentThreadSpawn]),
+                            archived: None,
+                            section_id: None,
+                            project_id: None,
+                            cwd: None,
+                            use_state_db_only: true,
+                            search_term: None,
+                            parent_thread_id: None,
+                            ancestor_thread_id: Some(root.to_string()),
+                        },
+                    })
+                    .await
+                    .map(|response| response.data)
+            } else {
+                Ok(Vec::new())
+            };
+
+            let result = collect_effort_status_readout(parent, agents);
+            app_event_tx.send(AppEvent::EffortStatusLoaded {
+                command,
+                scope,
+                result: Box::new(result),
+            });
+        });
+    }
+
+    pub(super) fn apply_effort_status(
+        &mut self,
+        command: String,
+        scope: EffortStatusScope,
+        result: Result<EffortStatusReadout, String>,
+    ) {
+        let readout = match result {
+            Ok(readout) => readout,
+            Err(err) => {
+                self.chat_widget
+                    .add_error_message(format!("Could not read live agent state: {err}"));
+                return;
+            }
+        };
+
+        let config = self.chat_widget.config_ref();
+        let snapshot = build_effort_status(EffortStatusInputs {
+            scope,
+            parent: readout.parent.as_ref(),
+            parent_fallback: self.chat_widget.effort_status_parent_fallback(),
+            agents: &readout.agents,
+            max_agents: config.agent_max_threads,
+            auto_routing_enabled: config.agents_enabled,
+            note: readout.note,
+        });
+        self.chat_widget.add_effort_status_output(command, snapshot);
+    }
+}
+
+/// Merges the two reads, degrading to a partial report rather than failing outright.
+///
+/// The parent row can fall back to the values the TUI already tracks, so a failed parent read only
+/// annotates the output. A failed agent listing with no parent record leaves nothing to show.
+fn collect_effort_status_readout<E: std::fmt::Display>(
+    parent: Result<ThreadReadResponse, E>,
+    agents: Result<Vec<Thread>, E>,
+) -> Result<EffortStatusReadout, String> {
+    let mut notes = Vec::new();
+    let parent = match parent {
+        Ok(response) => Some(response.thread),
+        Err(err) => {
+            tracing::warn!(%err, "failed to read the root thread for /effort");
+            notes.push(format!("parent runtime state unavailable ({err}); showing the values this session last applied"));
+            None
+        }
+    };
+    let agents = match agents {
+        Ok(agents) => agents,
+        Err(err) => {
+            if parent.is_none() {
+                return Err(err.to_string());
+            }
+            tracing::warn!(%err, "failed to list subagents for /effort");
+            notes.push(format!("subagent runtime state unavailable ({err})"));
+            Vec::new()
+        }
+    };
+
+    Ok(EffortStatusReadout {
+        parent,
+        agents,
+        note: (!notes.is_empty()).then(|| notes.join("; ")),
+    })
+}
+
+#[cfg(test)]
+#[path = "effort_status_tests.rs"]
+mod tests;
