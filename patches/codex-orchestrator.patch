+    let snapshot = snapshot_with(EffortStatusScope::Active, &parent, &agents);
+    let output = rendered(snapshot, 40);
+    for line in output.lines() {
+        assert!(
+            display_width(line) <= 40,
+            "line wider than the terminal: {line:?}"
+        );
+    }
+    insta::assert_snapshot!("effort_status_narrow", output);
+}
+
+#[test]
+fn agent_label_falls_back_to_nickname_then_thread_id() {
+    let mut nickname_only = base_thread("01998f00-0000-7000-8000-000000000009");
+    nickname_only.agent_nickname = Some("Cardamom".to_string());
+    assert_eq!(agent_label(&nickname_only), "Cardamom");
+
+    let bare = base_thread("01998f00-0000-7000-8000-00000000000a");
+    assert_eq!(agent_label(&bare), "00000000000a");
+}
