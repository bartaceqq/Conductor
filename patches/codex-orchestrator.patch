+//! `/effort` behaviour at the `ChatWidget` level.
+//!
+//! The central claim these tests defend is that `/effort` is a local inspection action: it asks
+//! `App` to read runtime state and it never puts anything on the op channel, so it cannot consume
+//! a model turn.
+
+use super::*;
+use crate::effort_status::EffortStatusScope;
+use codex_protocol::openai_models::ReasoningEffort as ReasoningEffortConfig;
+
+fn rendered_history(rx: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>) -> Vec<String> {
+    let mut out = Vec::new();
+    while let Ok(event) = rx.try_recv() {
+        if let AppEvent::InsertHistoryCell(cell) = event {
+            out.push(lines_to_single_string(&cell.display_lines(/*width*/ 100)));
+        }
+    }
+    out
+}
+
+#[tokio::test]
+async fn effort_command_requests_runtime_state_without_sending_a_model_request() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+
+    chat.dispatch_command(SlashCommand::Effort);
+
+    match rx.try_recv() {
+        Ok(AppEvent::RequestEffortStatus { command, scope }) => {
+            pretty_assertions::assert_eq!(command, "/effort");
+            pretty_assertions::assert_eq!(scope, EffortStatusScope::Active);
+        }
+        other => panic!("expected a runtime-state request, got {other:?}"),
+    }
+    assert!(
+        op_rx.try_recv().is_err(),
+        "/effort must not submit anything to the model"
+    );
+}
+
+#[tokio::test]
+async fn effort_scope_arguments_select_the_right_view() {
+    let cases = [
+        ("all", EffortStatusScope::All),
+        ("parent", EffortStatusScope::Parent),
+        ("agents", EffortStatusScope::Agents),
+        ("subagents", EffortStatusScope::Agents),
+    ];
+    for (arg, expected) in cases {
+        let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+        chat.dispatch_command_with_args(SlashCommand::Effort, arg.to_string(), Vec::new());
+
+        match rx.try_recv() {
+            Ok(AppEvent::RequestEffortStatus { command, scope }) => {
+                pretty_assertions::assert_eq!(command, format!("/effort {arg}"));
+                pretty_assertions::assert_eq!(scope, expected);
+            }
+            other => panic!("expected a runtime-state request for `{arg}`, got {other:?}"),
+        }
+        assert!(
+            op_rx.try_recv().is_err(),
+            "/effort {arg} must not submit an op"
+        );
+    }
+}
+
+#[tokio::test]
+async fn effort_level_argument_updates_the_parent_for_future_turns_only() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+
+    chat.dispatch_command_with_args(SlashCommand::Effort, "high".to_string(), Vec::new());
+
+    match rx.try_recv() {
+        Ok(AppEvent::UpdateReasoningEffort(Some(effort))) => {
+            pretty_assertions::assert_eq!(effort, ReasoningEffortConfig::High);
+        }
+        other => panic!("expected a reasoning-effort update, got {other:?}"),
+    }
+    assert!(
+        op_rx.try_recv().is_err(),
+        "/effort high must not submit anything to the model"
+    );
+}
+
+#[tokio::test]
+async fn unknown_effort_argument_explains_the_usage() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+
+    chat.dispatch_command_with_args(SlashCommand::Effort, "sideways".to_string(), Vec::new());
+
+    let rendered = rendered_history(&mut rx).join("\n");
+    assert!(
+        rendered.contains("/effort [all|parent|agents]"),
+        "expected the usage hint, got: {rendered}"
+    );
+    assert!(op_rx.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn effort_output_reports_the_parent_model_and_effort() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    let fallback = chat.effort_status_parent_fallback();
+
+    let snapshot =
+        crate::effort_status::build_effort_status(crate::effort_status::EffortStatusInputs {
+            scope: EffortStatusScope::Active,
+            parent: None,
+            parent_fallback: fallback,
+            agents: &[],
+            max_agents: Some(4),
+            auto_routing_enabled: true,
+            note: None,
+        });
+    chat.add_effort_status_output("/effort".to_string(), snapshot);
+
+    let rendered = rendered_history(&mut rx).join("\n");
+    assert!(rendered.contains("/effort"), "got: {rendered}");
+    assert!(
+        rendered.contains("Model / reasoning status"),
+        "got: {rendered}"
+    );
+    assert!(rendered.contains("parent"), "got: {rendered}");
+    assert!(rendered.contains("No active subagents."), "got: {rendered}");
+    assert!(rendered.contains("Routing: enabled"), "got: {rendered}");
+    assert!(op_rx.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn changing_the_model_changes_what_the_parent_row_falls_back_to() {
+    let (mut chat, _rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+
+    chat.set_reasoning_effort(Some(ReasoningEffortConfig::XHigh));
+    let fallback = chat.effort_status_parent_fallback();
+
+    pretty_assertions::assert_eq!(
+        fallback.reasoning_effort,
+        Some(ReasoningEffortConfig::XHigh)
+    );
+}
diff --git a/codex-rs/tui/src/effort_status.rs b/codex-rs/tui/src/effort_status.rs
new file mode 100644
index 0000000000..ea78aa8dfa
--- /dev/null
+++ b/codex-rs/tui/src/effort_status.rs
@@ -0,0 +1,473 @@
+//! Presentation model for the `/effort` command.
+//!
+//! `/effort` answers one question: which model and reasoning effort is each agent in this session
+//! *actually* running with right now. The rows are built from live app-server thread records, so
+//! the values shown are the ones Codex resolved after spawn overrides, `[agents]` defaults, parent
+//! inheritance, and agent-role config files have all been applied. Nothing here reads
+//! `config.toml` or an agent role file.
+//!
+//! The module keeps the data shaping and rendering free of `App`/`ChatWidget` state so both can be
+//! unit- and snapshot-tested directly.
+
+use std::str::FromStr;
+
+use codex_app_server_protocol::SessionSource;
+use codex_app_server_protocol::Thread;
+use codex_app_server_protocol::ThreadActiveFlag;
+use codex_app_server_protocol::ThreadStatus;
+use codex_protocol::ThreadId;
+use codex_protocol::openai_models::ReasoningEffort as ReasoningEffortConfig;
+use codex_protocol::protocol::SubAgentSource;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+
+use crate::history_cell::CompositeHistoryCell;
+use crate::history_cell::HistoryCell;
+use crate::history_cell::PlainHistoryCell;
+use crate::history_cell::plain_lines;
+use crate::width::display_width;
+
+/// Placeholder used whenever the runtime did not report a value.
+pub(crate) const UNKNOWN_VALUE: &str = "—";
+
+/// Minimum width before the aligned table collapses into stacked rows.
+const NARROW_LAYOUT_WIDTH: u16 = 56;
+
+const COLUMN_GAP: usize = 2;
+
+/// Which agents `/effort` should list.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub(crate) enum EffortStatusScope {
+    /// Parent plus subagents that are still open in this session.
+    #[default]
+    Active,
+    /// Parent plus every subagent this session spawned, including finished ones.
+    All,
+    /// Parent only.
+    Parent,
+    /// Subagents only.
+    Agents,
+}
+
+impl EffortStatusScope {
+    /// Parses the inline argument of `/effort`. Returns `None` for an empty argument.
+    pub(crate) fn parse(arg: &str) -> Result<Self, String> {
+        match arg.trim().to_ascii_lowercase().as_str() {
+            "" => Ok(Self::Active),
+            "all" => Ok(Self::All),
+            "parent" | "main" => Ok(Self::Parent),
+            "agents" | "subagents" | "workers" => Ok(Self::Agents),
+            other => Err(other.to_string()),
+        }
+    }
+
+    fn includes_parent(self) -> bool {
+        !matches!(self, Self::Agents)
+    }
+
+    fn includes_agents(self) -> bool {
+        !matches!(self, Self::Parent)
+    }
+
+    fn includes_finished_agents(self) -> bool {
+        matches!(self, Self::All)
+    }
+
+    fn title(self) -> &'static str {
+        match self {
+            Self::Active | Self::All => "Model / reasoning status",
+            Self::Parent => "Model / reasoning status — parent",
+            Self::Agents => "Model / reasoning status — subagents",
+        }
+    }
+}
+
+/// Live state of one agent, already reduced to display strings.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct EffortRow {
+    pub(crate) label: String,
+    pub(crate) model: String,
+    pub(crate) effort: String,
+    pub(crate) state: &'static str,
+    /// True when the row's model and effort both match the parent's.
+    pub(crate) inherited: bool,
+    pub(crate) is_parent: bool,
+}
+
+/// Everything `/effort` renders for one invocation.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct EffortStatusSnapshot {
+    pub(crate) scope: EffortStatusScope,
+    pub(crate) rows: Vec<EffortRow>,
+    pub(crate) active_agents: usize,
+    pub(crate) max_agents: Option<usize>,
+    pub(crate) auto_routing_enabled: bool,
+    /// Diagnostic shown when some runtime value could not be read.
+    pub(crate) note: Option<String>,
+}
+
+/// Values the TUI already holds for the parent thread, used when the live read is unavailable.
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub(crate) struct ParentFallback {
+    pub(crate) model: Option<String>,
+    pub(crate) reasoning_effort: Option<ReasoningEffortConfig>,
+}
+
+/// Runtime inputs gathered for one `/effort` invocation.
+pub(crate) struct EffortStatusInputs<'a> {
+    pub(crate) scope: EffortStatusScope,
+    /// Live record for the session's root thread, when the read succeeded.
+    pub(crate) parent: Option<&'a Thread>,
+    pub(crate) parent_fallback: ParentFallback,
+    /// Live records for every subagent thread descended from the root.
+    pub(crate) agents: &'a [Thread],
+    pub(crate) max_agents: Option<usize>,
+    pub(crate) auto_routing_enabled: bool,
+    pub(crate) note: Option<String>,
+}
+
+/// Reduces live thread records to the rows `/effort` prints.
+pub(crate) fn build_effort_status(inputs: EffortStatusInputs<'_>) -> EffortStatusSnapshot {
+    let EffortStatusInputs {
+        scope,
+        parent,
+        parent_fallback,
+        agents,
+        max_agents,
+        auto_routing_enabled,
+        note,
+    } = inputs;
+
+    let parent_model = parent
+        .and_then(|thread| thread.model.clone())
+        .or_else(|| parent_fallback.model.clone())
+        .filter(|model| !model.is_empty());
+    let parent_effort = parent
+        .and_then(|thread| thread.reasoning_effort.clone())
+        .or_else(|| parent_fallback.reasoning_effort.clone());
+
+    let mut rows = Vec::new();
+    if scope.includes_parent() {
+        rows.push(EffortRow {
+            label: "parent".to_string(),
+            model: display_model(parent_model.as_deref()),
+            effort: display_effort(parent_effort.as_ref()),
+            state: parent.map_or("unknown", |thread| thread_state_label(thread, true)),
+            inherited: false,
+            is_parent: true,
+        });
+    }
+
+    let mut active_agents = 0usize;
+    let mut agent_rows = Vec::new();
+    for thread in agents {
+        let finished = is_finished(&thread.status);
+        if !finished {
+            active_agents += 1;
+        }
+        if !scope.includes_agents() || (finished && !scope.includes_finished_agents()) {
+            continue;
+        }
+        let model = thread.model.clone().filter(|model| !model.is_empty());
+        let effort = thread.reasoning_effort.clone();
+        let inherited =
+            model.is_some() && model == parent_model && effort.is_some() && effort == parent_effort;
+        agent_rows.push((
+            thread.updated_at,
+            EffortRow {
+                label: agent_label(thread),
+                model: display_model(model.as_deref()),
+                effort: display_effort(effort.as_ref()),
+                state: thread_state_label(thread, false),
+                inherited,
+                is_parent: false,
+            },
+        ));
+    }
+    // Oldest spawn first so the transcript reads in the order the agents started.
+    agent_rows.sort_by_key(|(updated_at, _)| *updated_at);
+    rows.extend(agent_rows.into_iter().map(|(_, row)| row));
+
+    EffortStatusSnapshot {
+        scope,
+        rows,
+        active_agents,
+        max_agents,
+        auto_routing_enabled,
+        note,
+    }
+}
+
+/// Picks the most descriptive name Codex knows for a spawned agent thread.
+fn agent_label(thread: &Thread) -> String {
+    let source_role = match &thread.source {
+        SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            agent_path,
+            agent_nickname,
+            agent_role,
+            ..
+        }) => {
+            let role = agent_role
+                .as_deref()
+                .map(str::trim)
+                .filter(|role| !role.is_empty());
+            let nickname = agent_nickname
+                .as_deref()
+                .map(str::trim)
+                .filter(|nickname| !nickname.is_empty());
+            let path = agent_path
+                .as_ref()
+                .map(|path| path.name().to_string())
+                .filter(|name| !name.is_empty());
+            role.map(ToOwned::to_owned)
+                .or_else(|| nickname.map(ToOwned::to_owned))
+                .or(path)
+        }
+        _ => None,
+    };
+    source_role
+        .or_else(|| {
+            thread
+                .agent_role
+                .as_deref()
+                .map(str::trim)
+                .filter(|role| !role.is_empty())
+                .map(ToOwned::to_owned)
+        })
+        .or_else(|| {
+            thread
+                .agent_nickname
+                .as_deref()
+                .map(str::trim)
+                .filter(|nickname| !nickname.is_empty())
+                .map(ToOwned::to_owned)
+        })
+        .unwrap_or_else(|| short_thread_id(&thread.id))
+}
+
+fn short_thread_id(thread_id: &str) -> String {
+    match ThreadId::from_string(thread_id) {
+        Ok(thread_id) => {
+            let rendered = thread_id.to_string();
+            rendered
+                .split('-')
+                .next_back()
+                .map(ToOwned::to_owned)
+                .unwrap_or(rendered)
+        }
+        Err(_) => thread_id.to_string(),
+    }
+}
