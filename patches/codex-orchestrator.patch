+    thread.reasoning_effort = effort;
+    thread.status = status;
+    thread.updated_at = updated_at;
+    thread.agent_role = Some(role.to_string());
+    thread.source = ApiSessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+        parent_thread_id: ThreadId::from_string("01998f00-0000-7000-8000-000000000000")
+            .expect("thread id"),
+        depth: 1,
+        agent_path: AgentPath::root().resolve(role).ok(),
+        agent_nickname: None,
+        agent_role: Some(role.to_string()),
+    });
