+/// Live thread records collected for one `/effort` invocation.
+#[derive(Debug, Default)]
+pub(crate) struct EffortStatusReadout {
+    /// Live record for the session's root thread, when the read succeeded.
+    pub(crate) parent: Option<Thread>,
+    /// Live records for the root thread's spawned subagents.
+    pub(crate) agents: Vec<Thread>,
+    /// Set when part of the read failed and the output is therefore incomplete.
+    pub(crate) note: Option<String>,
+}
+
