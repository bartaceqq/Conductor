+fn display_model(model: Option<&str>) -> String {
+    match model {
+        Some(model) => crate::model_catalog::model_display_name(model).to_string(),
+        None => UNKNOWN_VALUE.to_string(),
+    }
+}
+
+fn display_effort(effort: Option<&ReasoningEffortConfig>) -> String {
+    match effort {
+        Some(effort) => effort.to_string(),
+        None => UNKNOWN_VALUE.to_string(),
+    }
+}
+
+/// Maps the app-server thread status onto the vocabulary `/effort` prints.
+///
+/// The labels stay close to what Codex actually tracks: a spawned agent that has finished its turn
+/// but is still open is reported by the runtime as idle, not completed, so that is what we show.
+fn thread_state_label(thread: &Thread, is_parent: bool) -> &'static str {
+    match &thread.status {
+        ThreadStatus::Active { active_flags } => {
+            if active_flags.contains(&ThreadActiveFlag::WaitingOnApproval) {
+                "approval"
+            } else if active_flags.contains(&ThreadActiveFlag::WaitingOnUserInput) {
+                "waiting"
+            } else {
+                "working"
+            }
+        }
+        ThreadStatus::Idle => "idle",
+        ThreadStatus::SystemError => "failed",
+        ThreadStatus::NotLoaded if is_parent => "idle",
+        ThreadStatus::NotLoaded => "closed",
+    }
+}
+
+fn is_finished(status: &ThreadStatus) -> bool {
+    matches!(status, ThreadStatus::NotLoaded)
+}
+
+/// Reasoning efforts `/effort <level>` accepts as a parent override.
+pub(crate) fn parse_effort_level(arg: &str) -> Option<ReasoningEffortConfig> {
+    let arg = arg.trim().to_ascii_lowercase();
+    if arg.is_empty() {
+        return None;
+    }
+    let effort = ReasoningEffortConfig::from_str(&arg).ok()?;
+    // `Custom` is the catch-all for unknown wire values; treat it as "not a level".
+    match effort {
+        ReasoningEffortConfig::Custom(_) => None,
+        effort => Some(effort),
+    }
+}
